PAPERMILL := papermill

FIT_NOTEBOOK := matrix_03_fit_parameters_fraccL_mod.ipynb
FIT_DIR := fits_ready

FIT_NAMES := \
	KPNO-M42-H-bin0 \
    KPNO-M42-S-bin0 \
	KPNO-M42-N-bin0 \
	KPNO-M42-O-bin0

FIT_STEPS := 3 4 6 7 8

FIT_OUTPUTS := $(foreach name,$(FIT_NAMES),$(foreach step,$(FIT_STEPS),$(FIT_DIR)/$(name)_0$(step).fits))


.PHONY: fit-fractions show-fit-fractions

.NOTPARALLEL: fit-fractions


fit-fractions: $(FIT_OUTPUTS)


show-fit-fractions:
	@echo $(FIT_OUTPUTS)


define FIT_RULE

$(FIT_DIR)/$(1)_0$(2).fits: $(FIT_DIR)/$(1).fits $(FIT_NOTEBOOK)
	$(PAPERMILL) "$(FIT_NOTEBOOK)" "exec_fit_$(1)_0$(2).ipynb" -p name "$(1)" -p fits_path "$(FIT_DIR)/$(1).fits" -p fit_limit "0.$(2)"

endef


$(foreach name,$(FIT_NAMES),$(foreach step,$(FIT_STEPS),$(eval $(call FIT_RULE,$(name),$(step)))))
