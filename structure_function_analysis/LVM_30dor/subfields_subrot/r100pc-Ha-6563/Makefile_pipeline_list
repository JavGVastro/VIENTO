# ----------------------------
# Core config
# ----------------------------
PYTHON := python

# Notebooks (templates)
NOTEBOOK_SF := list_02_correlation_computation.ipynb
NOTEBOOK_FIT := list_03_fit_parameters.ipynb

# File lists (one ID per line; blank lines and #comments allowed)
LIST := fits_ready/filelist.txt

# ----------------------------
# Helper: read list file -> space-separated IDs
# ----------------------------
define read_list
$(shell $(PYTHON) -c "import pathlib; p=pathlib.Path('$(1)'); \
t=p.read_text(encoding='utf-8').splitlines(); \
ids=[l.strip() for l in t if l.strip() and not l.strip().startswith('#')]; \
print(' '.join(ids))")
endef

FILE_IDS_SF  := $(call read_list,$(LIST))
FILE_IDS_FIT := $(call read_list,$(LIST))

# ----------------------------
# Executed notebook outputs (ROOT dir with prefixes)
# ----------------------------
EXEC_NBS_SF  := $(addprefix exec_sf_,$(addsuffix .ipynb,$(FILE_IDS_SF)))
EXEC_NBS_FIT := $(addprefix exec_fit_,$(addsuffix .ipynb,$(FILE_IDS_FIT)))

# ----------------------------
# Targets
# ----------------------------
.PHONY: help list_sf list_fit sf fit all one_sf one_fit clean

help:
	@echo Targets:
	@echo "  make list_sf                 # show IDs from $(LIST) (SF)"
	@echo "  make list_fit                # show IDs from $(LIST) (FIT)"
	@echo "  make sf                      # run SF list through $(NOTEBOOK_SF)"
	@echo "  make fit                     # run FIT list through $(NOTEBOOK_FIT)"
	@echo "  make all                     # run both"
	@echo "  make one_sf NAME=<ID>        # run a single SF ID"
	@echo "  make one_fit NAME=<ID>       # run a single FIT ID"
	@echo "  make clean                   # delete executed notebooks in root (exec_sf_*.ipynb, exec_fit_*.ipynb)"

list_sf:
	@echo $(FILE_IDS_SF)

list_fit:
	@echo $(FILE_IDS_FIT)

sf: $(EXEC_NBS_SF)
	@echo "Done SF. Outputs in project root: exec_sf_<ID>.ipynb"

fit: $(EXEC_NBS_FIT)
	@echo "Done FIT. Outputs in project root: exec_fit_<ID>.ipynb"

all: sf fit

# ----------------------------
# Pattern rule: SF
# Target example: exec_sf_<ID>.ipynb
# ----------------------------
exec_sf_%.ipynb: $(NOTEBOOK_SF) $(LIST) pipeline_config.py
	@echo "Running SF notebook for ID: $*"
	@$(PYTHON) -m papermill "$(NOTEBOOK_SF)" "$@" \
		-p name "$*" \
		-p fits_path "fits_ready/$*.fits"

# ----------------------------
# Pattern rule: FIT
# Target example: exec_fit_<ID>.ipynb
# ----------------------------
exec_fit_%.ipynb: $(NOTEBOOK_FIT) $(LIST) pipeline_config.py
	@echo "Running FIT notebook for ID: $*"
	@$(PYTHON) -m papermill "$(NOTEBOOK_FIT)" "$@" \
		-p name "$*" \
		-p fits_path "fits_ready/$*.fits"

# Single-run SF
one_sf:
	$(if $(NAME),,$(error Provide NAME=<ID>))
	@echo "Running SF notebook for ID: $(NAME)"
	@$(PYTHON) -m papermill "$(NOTEBOOK_SF)" "exec_sf_$(NAME).ipynb" \
		-p name "$(NAME)" \
		-p fits_path "fits_ready/$(NAME).fits"

# Single-run FIT
one_fit:
	$(if $(NAME),,$(error Provide NAME=<ID>))
	@echo "Running FIT notebook for ID: $(NAME)"
	@$(PYTHON) -m papermill "$(NOTEBOOK_FIT)" "exec_fit_$(NAME).ipynb" \
		-p name "$(NAME)" \
		-p fits_path "fits_ready/$(NAME).fits"

clean:
	@$(PYTHON) -c "import glob, os; \
files = glob.glob('exec_sf_*.ipynb') + glob.glob('exec_fit_*.ipynb'); \
[os.remove(f) for f in files]; \
print('Removed', len(files), 'files')"
